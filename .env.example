# NVIDIA NIM API Key (to use GLM-5.3-flash or other NIM models via NVIDIA's API)
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional model override. Default: z-ai/glm-5.3-flash (confirmed working NIM tag)
# Other valid NIM tags: meta/llama-3.1-70b-instruct, mistralai/mistral-large-2-instruct
NVIDIA_MODEL=z-ai/glm-5.3-flash

# Anthropic API Key — first provider in the cascade (Anthropic → DeepSeek → NVIDIA)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional model override. Default: claude-opus-5-5 (current, most capable Opus).
# Reasoning effort (medium/high) is chosen per-audit in the UI, not here.
ANTHROPIC_MODEL=claude-opus-5-5
# Only needed if ANTHROPIC_API_KEY is an ORG-LEVEL (unscoped) key. Workspace-scoped
# keys work without it. Find the ID in the Anthropic Console workspace URL/settings.
# ANTHROPIC_WORKSPACE_ID=
#
# ── Subscription (OAuth) mode — draws from a Claude Pro/Max plan's limits instead of
# API credits, the same way Claude Code authenticates. Set this INSTEAD of ANTHROPIC_API_KEY.
# Get a token with:  ant auth print-credentials --access-token
# Caveats: (1) subscription tokens may be scoped to first-party tools and rejected for
# third-party apps; (2) access tokens are SHORT-LIVED and must be refreshed periodically.
# ANTHROPIC_AUTH_TOKEN=

# DeepSeek API Key — used after Anthropic in the provider cascade
# Get yours at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional model override. Default: deepseek-v4-pro. Cheaper/faster: deepseek-flash
DEEPSEEK_MODEL=deepseek-v4-pro

# Solodit API Key — optional, corroborates findings against 50k+ real audit-
# contest reports. Get yours at: https://solodit.cyfrin.io/ (account dropdown)
SOLODIT_API_KEY=your_solodit_key_here

# Access code required to unlock the app (set by you, not committed)
ACCESS_CODE=change_me

# Random secret used to sign the session cookie — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me
