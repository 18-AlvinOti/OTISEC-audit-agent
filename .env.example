# Gemini API Key — preferred provider for live contract auditing
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Gemini model — optional. Defaults to gemini-2.5-flash (free-tier friendly).
# Set to gemini-2.5-pro or a gemini-3.x model if your key's project has billing enabled.
GEMINI_MODEL=gemini-2.5-flash

# Anthropic API Key — fallback provider if GEMINI_API_KEY is not set
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Solodit API Key — optional, corroborates findings against 50k+ real audit-
# contest reports. Get yours at: https://solodit.cyfrin.io/ (account dropdown)
SOLODIT_API_KEY=your_solodit_key_here

# Access code required to unlock the app (set by you, not committed)
ACCESS_CODE=change_me

# Random secret used to sign the session cookie — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me
